# ============================================================================
#  Variables de entorno del setter-bot. Copiá esto a .env (local) o cargalo
#  en Railway. Lo ÚNICO que vas a tocar para cambiar cómo habla el bot está en
#  src/persona.js, no acá.
# ============================================================================

# --- Claude (cerebro del bot) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opcional). Default: claude-haiku-4-5 (barato). Para más cabeza en la
# conversación podés subir a claude-sonnet-4-6 (más caro). El código se adapta
# solo (thinking/effort solo en modelos que lo soportan).
# CLAUDE_MODEL=claude-haiku-4-5

# --- Google (Calendar + opcional Sheet de registro) ---
# Credenciales de la service account, en base64 (cómodo para Railway):
GOOGLE_CREDENTIALS_B64=
# ...o el JSON crudo:
# GOOGLE_CREDENTIALS_JSON=
# El calendario donde agenda (compartilo con el email de la service account como
# "Hacer cambios en eventos"). Default: "primary".
CALENDAR_ID=primary
# Zona horaria de las llamadas:
TIMEZONE=America/Argentina/Buenos_Aires

# --- CRM (Google Sheet, opcional) ---
# Si lo seteás, el bot mantiene una fila por lead al día (estado, último mensaje,
# próximo follow-up, llamada agendada...). Compartí la planilla con el email de la
# service account como Editor. Vacío = sin CRM.
SHEET_ID=
SHEET_TAB=CRM

# --- WhatsApp (Baileys) ---
# Número del bot (solo dígitos con código de país). Si está seteado y la sesión
# no está vinculada, se vincula por CÓDIGO en vez de QR.
PAIRING_NUMBER=
# Sembrar una sesión ya vinculada (base64). Para migrar la sesión local a Railway.
AUTH_SEED_B64=

# --- Avisos al dueño ---
# Tu número personal (solo dígitos, con país) para que el bot te avise cuando
# agenda una llamada. Dejalo vacío para no recibir avisos.
OWNER_NUMBER=

# --- Persistencia ---
DATA_DIR=.

# --- Inteligencia ---
# Esfuerzo de Claude por respuesta (low = rápido/barato, sube si querés más cabeza).
# CLAUDE_EFFORT=low
# Análisis IA por lead (estilo/objeción/temperatura). 1 = on, 0 = off.
INSIGHTS=1
# Exploración del A/B de openers (0.2 = 20% del tiempo prueba variantes nuevas).
# BANDIT_EPSILON=0.2
# Recordatorios anti no-show antes de la llamada (24h y 1h). 1 = on, 0 = off.
REMINDERS=1
# Opener personalizado al anuncio cuando el lead llega de Click-to-WhatsApp.
# 1 = on (si hay API key), 0 = usa el opener fijo del A/B.
PERSONALIZED_OPENER=1

# --- Interruptores ---
# Botón de pánico: el bot se conecta pero NO le escribe a nadie.
BOT_PAUSED=0
# Borra la sesión de WhatsApp al boot (re-vincular limpio).
WIPE_AUTH=0
# Borra el estado de los leads (conversaciones/agendas) al boot.
RESET_STATE=0

# ============================================================================
#  DEVOLUCION DE LA VENTA A META (API de Conversiones para mensajeria)
#  Cierra el circuito: cuando el vendedor del cliente marca una consulta como
#  ganada, se le devuelve el evento a Meta con su valor para que la campana
#  optimice hacia compradores y no hacia leads baratos. Anexo spec §6.6.
#  Sin las dos primeras el lote corre igual, pero solo en modo de prueba.
# ============================================================================
# Id del conjunto de datos (dataset) de mensajeria. Se crea una sola vez con
# POST /{WABA_ID}/dataset y despues se copia aca.
META_DATASET_ID=
# Token con los permisos whatsapp_business_management y
# whatsapp_business_manage_events. System User permanente para produccion.
META_ACCESS_TOKEN=
# Id de la cuenta de WhatsApp Business. Si ya esta WABA_ID, se reusa solo.
# META_WABA_ID=
# Version de Graph para los eventos (default: la del bot, v25.0).
# META_GRAPH_VERSION=v26.0
# Codigo de "Eventos de prueba" del Administrador de eventos: los eventos van
# al tablero de prueba en vez de a los datos reales. Vacio en produccion.
META_TEST_EVENT_CODE=
# Moneda de los montos declarados.
META_CURRENCY=ARS
# Que evento se devuelve cuando una fila pasa a ganado.
# META_EVENT_NAME=Purchase
# Mandar el telefono hasheado (SHA-256) adentro del evento. 0 = no (default):
# el ctwa_clid ya alcanza para atribuir.
META_ENVIAR_TELEFONO=0
# Mandar la venta aunque no haya monto declarado. 0 = no (default): la doc pide
# value + currency para Purchase, y un monto inventado es peor que nada.
META_ENVIAR_SIN_VALOR=0
# Cuenta publicitaria (act_...). Opcional, solo para la reconciliacion.
META_AD_ACCOUNT_ID=
# Override del endpoint. Vacio en produccion. Solo para probar contra un
# servidor local o salir por un proxy.
META_EVENTS_URL=

# --- De donde salen las ventas declaradas por el vendedor -------------------
# Pestana de la planilla con las columnas del Grupo B. Vacio = la del CRM.
# Columnas que tiene que tener, con estos titulos exactos:
#   Estado comercial · Fecha del estado · Motivo de perdida ·
#   Monto de la venta · Fecha de la venta · Moneda
# OJO: no las llames "Estado" a secas, esa columna la escribe y la pisa el bot.
VENTAS_SHEET_TAB=
# Archivo local de ventas (alternativa a la planilla, y lo que permite probar
# sin credenciales de Google). Default: $DATA_DIR/ventas-declaradas.json
VENTAS_FILE=
